# Copy to .env.local and fill in at least GROQ_API_KEY (the default provider).

# --- Groq (default provider) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional unused fallback slot for a second Groq key.
GROQ_API_KEY_BACKUP=

# --- Gemini (optional second provider) ---
# Only needed if LLM_PROVIDER=gemini below. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Provider switch ---
# "groq" (default) or "gemini"
LLM_PROVIDER=groq

# --- Session storage (optional, recommended on Vercel) ---
# Not needed for local dev (falls back to a disk-backed store automatically).
# On Vercel specifically, each request can land on a different serverless
# instance with its own memory AND its own /tmp — without a real shared
# store, an in-progress interview can "disappear" mid-conversation. Add the
# free Upstash-for-Redis integration from the Vercel Marketplace to your
# project and it injects these automatically (no manual copy-pasting needed):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (Upstash's own naming also works if you set up Redis directly instead:
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=)
