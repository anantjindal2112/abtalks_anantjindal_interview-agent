# Copy to .env.local and fill in at least GROQ_API_KEY (the default provider).

# --- Groq (default provider) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional unused fallback slot for a second Groq key.
GROQ_API_KEY_BACKUP=

# --- Gemini (optional second provider) ---
# Only needed if LLM_PROVIDER=gemini below. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Provider switch ---
# "groq" (default) or "gemini"
LLM_PROVIDER=groq
